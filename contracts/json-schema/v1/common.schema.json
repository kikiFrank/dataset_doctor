{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://datasetdoctor.invalid/contracts/json-schema/v1/common.schema.json",
  "title": "Dataset Doctor shared JSON definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "track_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_annotation_id", "track_id", "tracking_task_id", "tracking_attempt_id"],
      "properties": {
        "local_annotation_id": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "track_id": { "$ref": "#/$defs/uuid" },
        "tracking_task_id": { "$ref": "#/$defs/uuid" },
        "tracking_attempt_id": { "$ref": "#/$defs/uuid" }
      }
    }
  }
}
