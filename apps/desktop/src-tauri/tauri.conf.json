{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dataset Doctor",
  "version": "0.1.0",
  "identifier": "org.datasetdoctor.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' dd-media: http://dd-media.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
